HELMET_ENVIRONMENT=development
HELMET_CORS_ORIGINS=["http://localhost:3000"]

# local  = SQLite at HELMET_LOCAL_DATABASE_PATH, no external services needed
# supabase = requires the three HELMET_SUPABASE_* / owner values below
HELMET_PERSISTENCE_BACKEND=local
HELMET_LOCAL_DATABASE_PATH=data/helmet.db

# In local mode this may be any label; in Supabase mode it must be the auth user UUID.
HELMET_OWNER_USER_ID=

HELMET_SUPABASE_URL=
HELMET_SUPABASE_KEY=

HELMET_ANTHROPIC_API_KEY=
HELMET_ANTHROPIC_MODEL=claude-sonnet-4-6
